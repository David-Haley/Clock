with "../Pi_Common/lib_gpiod.gpr";
with "../Pi_Common/lib_mosquitto.gpr";
with "../Pi_Common/lib_gnatcoll.gpr";
with "../Pi_Common/lib_gnatcoll_minimal.gpr";

project Iot_Clock is

   for Source_Dirs use ("src", "../DJH/src", "../DJH/src", "../Pi_Common/src", "../Pi_Common_C/src");
   for Object_Dir use "obj";
   for Main use ("clock_ui.adb", "iot_clock.adb", "test_chime.adb",
     "test_clock.adb", "topic_editor.adb", "test_topic_manager.adb",
     "test_topic_management.adb");
   for Languages use ("Ada", "C");

   package Compiler is
      for Switches ("c") use ("-g", "-pedantic");
      for Switches ("ada") use ("-g", "-gnat2022", "-gnatd_F",
        "-gnatwa", "-gnatVa", "-gnatyk", "-gnaty3", "-gnatya", "-gnatyk",
        "-gnatyl", "-gnatyn", "-gnatyr", "-gnaty-d");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Linker is
      for Linker_Options use ("-g", "-lgpiod"); -- add -v here to debug linker issues
   end Linker;

end Iot_Clock;

